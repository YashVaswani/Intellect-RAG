# Google Gemini (Default LLM & Embeddings)
GOOGLE_API_KEY=your_google_genai_key_here

# Groq (Llama, Qwen, DeepSeek)
GROQ_API_KEY=your_groq_api_key_here

# Qdrant Vector Database
QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key

# Cohere (Cross-Encoder Reranking)
COHERE_API_KEY=your_cohere_api_key

# Tavily (Live Web Search Fallback)
TAVILY_API_KEY=your_tavily_api_key

# Optional: Disable Guardrails in development
# GUARDRAIL_ENABLED=False

# ─── Authentication ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ─── OTP Delivery ───────────────────────────────────────────

# Gmail SMTP (for email OTPs)
# Use a Gmail App Password — NOT your regular Gmail password.
# Get one at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# MSG91 (for SMS OTPs — Indian phone numbers) — optional/paid
MSG91_AUTHKEY=your_msg91_authkey
MSG91_TEMPLATE_ID=your_msg91_otp_template_id

# ─── Firebase (Free Phone OTP via SMS) ──────────────────────
# Create a project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Phone
# Then go to Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Frontend API URL ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
